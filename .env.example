# ---------------------------------------------------------------------------
# T Flash — environment variables (copy to .env.local for `pnpm dev`)
# You do NOT need any of these to run the UI. Add keys for the providers you
# want available to everyone, or paste a key in Settings → Providers (BYOK).
# ---------------------------------------------------------------------------

# Required in production (Better Auth). Dev generates a placeholder.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Optional: dedicated secret used to encrypt browser-supplied provider keys AND
# pasted integration tokens (GitHub, Vercel, Supabase, ...). Falls back to
# BETTER_AUTH_SECRET when omitted. Changing it invalidates existing browser
# connections, so users simply paste their tokens again.
#
# You do not need integration tokens here: Settings → Connections authorizes
# services in the browser and keeps the sealed grant there.
PROVIDER_KEYS_SECRET=

# --- In-app OAuth apps (Settings → Connections, one tap) -------------------
# Optional, but this is what makes "Connect" a consent screen instead of a
# pasted token. Register an app per service and use this redirect URI:
#   https://your-deployment/api/integrations/oauth/callback
# Without these the row explains the missing setup and offers a token instead.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
SENTRY_OAUTH_CLIENT_ID=
SENTRY_OAUTH_CLIENT_SECRET=
# Vercel *integration* OAuth (separate from the sign-in app above; sign-in
# tokens are identity-only and cannot call the REST API).
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
# Public client: PKCE, no secret. Override the base URL for the EU region.
POSTHOG_OAUTH_CLIENT_ID=
# POSTHOG_OAUTH_BASE_URL=https://eu.posthog.com

# Public origin of this deployment. Used as the OAuth redirect base (so it must
# match what you registered with GitHub, Vercel, ...) and sent to OpenRouter as
# HTTP-Referer / X-Title. Falls back to the request host when unset.
APP_URL=https://your-deployment.example

# --- Operator-wide provider keys (any subset) ------------------------------
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
CUSTOM_PROVIDER_API_KEY=

# Optional overrides for self-hosted OpenAI-compatible endpoints.
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
CUSTOM_BASE_URL=https://your-endpoint.example/v1

# Vercel AI Gateway is used by default (no key required on Vercel).
# AI_GATEWAY_API_KEY=

# --- Integrations (MCP tools) ---------------------------------------------
# Settings → Connections shows the live state of each of these. Two ways to
# authorize a service; either works per integration.
#
# 1) Vercel Connect (recommended, no secret in env):
#      vercel link
#      vercel connect create github --name t-flash
#      vercel connect attach <connector-uid> --yes
#      vercel env pull
#    Then pin the connector UID (user-scoped OAuth by default):
CONNECT_GITHUB_CONNECTOR=
CONNECT_LINEAR_CONNECTOR=
CONNECT_NOTION_CONNECTOR=
CONNECT_SENTRY_CONNECTOR=
CONNECT_SUPABASE_CONNECTOR=
CONNECT_NEON_CONNECTOR=
CONNECT_VERCEL_CONNECTOR=
CONNECT_POSTHOG_CONNECTOR=
CONNECT_STRIPE_CONNECTOR=
CONNECT_RESEND_CONNECTOR=
# Set to 1 to authenticate as the agent (shared credential) instead of the user.
# CONNECT_GITHUB_APP_SCOPED=1
#
# 2) Static bearer token (app-scoped, simplest for a single developer):
GITHUB_MCP_TOKEN=
LINEAR_API_TOKEN=
NOTION_API_TOKEN=
SENTRY_ACCESS_TOKEN=
SUPABASE_ACCESS_TOKEN=
NEON_API_KEY=
VERCEL_ACCESS_TOKEN=
POSTHOG_PERSONAL_API_KEY=
STRIPE_SECRET_KEY=
RESEND_API_KEY=
