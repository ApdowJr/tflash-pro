# Tflash — copy to .env.local. NEXT_PUBLIC values are safe for the browser
# and are embedded at build time; never put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://uatpsywxzdkdjhbclzve.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_kLQJ82DtLOu3XjNecH6Qpw_fvVRCOy6

# Required in production. Generate independent random secrets of at least
# 32 characters, keep them private and stable across Next/eve instances.
# In development only, missing secrets use insecure local-only fallbacks.
TFLASH_SESSION_SECRET=
PROVIDER_KEYS_SECRET=

# Public HTTPS application origin (also sent to OpenRouter as HTTP-Referer).
# On Vercel, VERCEL_URL can supply the internal origin automatically.
APP_URL=
# Optional trusted origin for server-to-server Eve calls. Leave empty unless
# it differs from APP_URL / VERCEL_URL (local default: http://127.0.0.1:3000).
TFLASH_INTERNAL_ORIGIN=
# Optional: server-only Vercel Deployment Protection automation bypass.
# Never use NEXT_PUBLIC_ for this secret or send it to browsers.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional operator-wide provider keys. Browser keys can instead be added in
# Settings → Providers and are sealed on the server for seven days.
AI_GATEWAY_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
CUSTOM_PROVIDER_API_KEY=

# Production: exact trusted host[:port] entries for every customizable
# provider endpoint (including default Ollama/LM Studio). Empty denies them.
# CUSTOM_PROVIDER_ALLOWED_HOSTS=api.example.com,localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1
# CUSTOM_BASE_URL=https://api.example.com/v1
