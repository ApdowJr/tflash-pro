# ---------------------------------------------------------------------------
# T Flash — environment variables (copy to .env.local for `pnpm dev`)
# You do NOT need any of these to run the UI. Add keys for the providers you
# want available to everyone, or paste a key in Settings → Providers (BYOK).
# ---------------------------------------------------------------------------

# Required in production (Better Auth). Dev generates a placeholder.
BETTER_AUTH_SECRET=replace-with-a-long-random-string
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Optional: dedicated secret used to encrypt browser-supplied provider keys.
# Falls back to BETTER_AUTH_SECRET when omitted. Changing it invalidates
# existing browser connections (users simply reconnect).
PROVIDER_KEYS_SECRET=

# Public origin sent to OpenRouter as HTTP-Referer / X-Title (optional).
APP_URL=https://your-deployment.example

# --- Operator-wide provider keys (any subset) ------------------------------
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
CUSTOM_PROVIDER_API_KEY=

# Optional overrides for self-hosted OpenAI-compatible endpoints.
OLLAMA_BASE_URL=http://localhost:11434/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
CUSTOM_BASE_URL=https://your-endpoint.example/v1

# Vercel AI Gateway is used by default (no key required on Vercel).
# AI_GATEWAY_API_KEY=
